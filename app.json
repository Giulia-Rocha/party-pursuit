{
  "expo": {
    "name": "Party Pursuit",
    "slug": "party-pursuit",
    "version": "1.0.0",
    "scheme": "party-pursuit",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05060C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.partypursuit.app"
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#05060C"
      },
      "package": "com.partypursuit.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-location", { "locationWhenInUsePermission": "Usamos sua localização para mostrar mesas de jogos próximas." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
